{
  "project": "Ralph Flowchart",
  "description": "Add a visible safety legend to the hardened Ralph flowchart.",
  "userStories": [
    {
      "id": "US-001",
      "title": "Add safety legend content",
      "description": "As an operator, I want the flowchart to distinguish worker and orchestrator authority.",
      "acceptanceCriteria": [
        "The legend identifies worker output as untrusted",
        "The legend identifies state, checks, and Git commits as orchestrator-owned",
        "Flowchart lint and build pass"
      ],
      "priority": 1,
      "allowedPaths": [
        "flowchart/src/**"
      ],
      "requiredChecks": [
        "flowchart-install",
        "flowchart-lint",
        "flowchart-build"
      ],
      "references": [
        "SPEC.md"
      ],
      "requiresBrowser": false
    },
    {
      "id": "US-002",
      "title": "Document safety legend behavior",
      "description": "As a maintainer, I want the flowchart documentation to explain the safety legend.",
      "acceptanceCriteria": [
        "Flowchart README describes the legend and its trust boundary",
        "Flowchart lint and build pass"
      ],
      "priority": 2,
      "allowedPaths": [
        "flowchart/README.md"
      ],
      "requiredChecks": [
        "flowchart-install",
        "flowchart-lint",
        "flowchart-build"
      ],
      "dependsOn": [
        "US-001"
      ],
      "requiresBrowser": true
    }
  ]
}
